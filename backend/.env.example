# Copy to backend/.env or export these in your shell. Names only: put real values in your own environment, never in the repo.
# Required (32+ characters)
GW_JWT_SECRET=
# Optional core settings
GW_APP_NAME=
GW_MONGO_URL=mongodb://localhost:27017
GW_DB_NAME=groundwork
GW_MEDIA_DIR=
# Base64 of 32 random bytes. Vault endpoints refuse to run without it.
GW_VAULT_KEK=
# Where sign-in callbacks send the browser after login
GW_FRONTEND_ORIGIN=http://localhost:5173
# AI resume assist: stays off (HTTP 503, no paid call) while the key is empty
GW_META_MODEL_API_KEY=
GW_META_MODEL_API_URL=
# Federated sign-in: a provider is invisible until its id and secret are both set
GW_GOOGLE_CLIENT_ID=
GW_GOOGLE_CLIENT_SECRET=
GW_GOOGLE_REDIRECT_URI=
GW_FACEBOOK_APP_ID=
GW_FACEBOOK_APP_SECRET=
GW_FACEBOOK_REDIRECT_URI=
GW_MICROSOFT_CLIENT_ID=
GW_MICROSOFT_CLIENT_SECRET=
GW_MICROSOFT_REDIRECT_URI=
GW_LINKEDIN_CLIENT_ID=
GW_LINKEDIN_CLIENT_SECRET=
GW_LINKEDIN_REDIRECT_URI=
# Apple is plumbing only and is never enabled
GW_APPLE_CLIENT_ID=
GW_APPLE_CLIENT_SECRET=
GW_APPLE_REDIRECT_URI=
# Frontend build-time (frontend/.env): VITE_APP_NAME, VITE_SIBLING_NAME
